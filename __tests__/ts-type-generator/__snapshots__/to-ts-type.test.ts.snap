 */
type OptionalTestRecord = {
  literalString?: "literal";
  literalNumber?: 1;
  literalBoolean?: true;
  bMember?: Enum.B;
  id?: string;
  number?: number;
  bool?: boolean;
  enum?: Enum;
  tuple?: Tuple1;
  oneof?: Union1;
  dict?: Dict;
  stringArray?: ArrayType1;
  unionArray?: ArrayType2;
