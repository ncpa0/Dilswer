type RecordType5 = {
  foo: string;
};


type RecordType6 = {
  bar: string;
};

/**
 * Array of two possible record types
 */
type ArrayType4 = Array<RecordType5 | RecordType6>;


type SetType1 = Set<string>;


type RecordType7 = {
  a: string;
};


type RecordType8 = {
  b: number;
};


type Intersection = RecordType7 & RecordType8;


type TestRecord = {
  literalString: "literal";
  literalNumber: 1;
  literalBoolean: true;
  bMember: Enum.B;
  stringMatching: StringMatching;
  namedStringMatching: FooMatcher;
  /**
   * User unique identifier
   */
  uuid: string;
  number: number;
  bool: boolean;
  enum: Enum;
  symbol: symbol;
  undef: undefined;
  tuple: Tuple;
  /**
   * A tuple with a named type
   */
  namedTuple: ATuple;
  oneof: Union;
  /**
   * A record identical to the parent record, but with all fields optional
   */
  optionalSelfCopy?: OptionalTestRecord;
  dict: Dict1;
  stringArray: ArrayType3;
  /**
   * Array of two possible record types
   */
