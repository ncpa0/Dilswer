exports[`toTsType should correctly generate a complex type with 'compact' mode 1`] = `
"export type TestRecord = {
  literalString: "literal";
  literalNumber: 1;
  literalBoolean: true;
  bMember: Enum.B;
  stringMatching: string;
  namedStringMatching: '\\'foo\\'.\${string}';
  /**
   * User unique identifier
   */
  uuid: string;
  number: number;
  bool: boolean;
  enum: Enum;
  symbol: symbol;
  undef: undefined;
  tuple: [string, number];
  /**
   * A tuple with a named type
   */
  namedTuple: [Array<string>, Enum];
  oneof: {
    foo: string;
  } | {
    bar: string;
  };
  /**
   * A record identical to the parent record, but with all fields optional
   */
  optionalSelfCopy?: {
    literalString?: "literal";
    literalNumber?: 1;
    literalBoolean?: true;
    bMember?: Enum.B;
    id?: string;
    number?: number;
    bool?: boolean;
    enum?: Enum;
    tuple?: [string, number];
    oneof?: {
      foo: string;
    } | {
      bar: string;
    };
    dict?: Record<string | number, string>;
    stringArray?: Array<string>;
    unionArray?: Array<{
      foo: string;
    } | {
      bar: string;
    }>;
    stringSet?: Set<string>;
    recordIntersection?: {
      a: string;
    } & {
      b: number;
    };
  };
  dict: Record<string | number, string>;
  stringArray: Array<string>;
  /**
   * Array of two possible record types
   */
  unionArray: Array<{
    foo: string;
  } | {
    bar: string;
  }>;
  stringSet: Set<string>;
  recordIntersection: {
    a: string;
  } & {
    b: number;
  };
  customValidator: unknown;
};
"
`;

