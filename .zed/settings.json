{
  "languages": {
    "JavaScript": {
      "language_servers": ["!eslint", "!vtsls", "typescript-language-server"],
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "language_servers": ["!eslint", "!vtsls", "typescript-language-server"],
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "language_servers": ["!eslint", "!vtsls", "typescript-language-server"],
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"],
        },
      },
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"],
        },
      },
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"],
        },
      },
    },
  },
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "importModuleSpecifierPreference": "non-relative",
          "renameMatchingJsxTags": true,
        },
      },
    },
  },
}
